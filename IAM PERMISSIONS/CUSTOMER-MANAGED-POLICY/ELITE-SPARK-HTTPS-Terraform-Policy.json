{
	"Version": "2012-10-17",
	"Statement": [
		{
			"Sid": "HyderabadInfrastructure",
			"Effect": "Allow",
			"Action": [
				"ec2:*",
				"elasticloadbalancing:*",
				"autoscaling:*",
				"cloudwatch:*",
				"logs:*",
				"sns:*"
			],
			"Resource": "*",
			"Condition": {
				"StringEquals": {
					"aws:RequestedRegion": "ap-south-2"
				}
			}
		},
		{
			"Sid": "HyderabadACM",
			"Effect": "Allow",
			"Action": [
				"acm:DescribeCertificate",
				"acm:GetCertificate",
				"acm:ListCertificates",
				"acm:ListTagsForCertificate"
			],
			"Resource": "*",
			"Condition": {
				"StringEquals": {
					"aws:RequestedRegion": "ap-south-2"
				}
			}
		},
		{
			"Sid": "HyderabadSSMParameters",
			"Effect": "Allow",
			"Action": [
				"ssm:GetParameter",
				"ssm:GetParameters"
			],
			"Resource": "*",
			"Condition": {
				"StringEquals": {
					"aws:RequestedRegion": "ap-south-2"
				}
			}
		},
		{
			"Sid": "HyderabadFinanceS3",
			"Effect": "Allow",
			"Action": [
				"s3:CreateBucket",
				"s3:DeleteBucket",
				"s3:GetBucketLocation",
				"s3:GetBucketTagging",
				"s3:PutBucketTagging",
				"s3:GetBucketVersioning",
				"s3:PutBucketVersioning",
				"s3:GetEncryptionConfiguration",
				"s3:PutEncryptionConfiguration",
				"s3:GetLifecycleConfiguration",
				"s3:PutLifecycleConfiguration",
				"s3:GetBucketPublicAccessBlock",
				"s3:PutBucketPublicAccessBlock",
				"s3:GetReplicationConfiguration",
				"s3:PutReplicationConfiguration",
				"s3:GetBucketPolicy",
				"s3:PutBucketPolicy",
				"s3:DeleteBucketPolicy",
				"s3:ListBucket",
				"s3:PutObject",
				"s3:GetObject",
				"s3:DeleteObject",
				"s3:DeleteObjectVersion"
			],
			"Resource": [
				"arn:aws:s3:::elite-spark-finance-hyd-*",
				"arn:aws:s3:::elite-spark-finance-hyd-*/*"
			]
		},
		{
			"Sid": "ManageAppEC2Role",
			"Effect": "Allow",
			"Action": [
				"iam:GetRole",
				"iam:GetRolePolicy",
				"iam:ListRolePolicies",
				"iam:PutRolePolicy",
				"iam:DeleteRolePolicy",
				"iam:ListAttachedRolePolicies",
				"iam:UpdateAssumeRolePolicy",
				"iam:TagRole",
				"iam:UntagRole"
			],
			"Resource": "arn:aws:iam::257074875139:role/APP-EC2-ROLE"
		},
		{
			"Sid": "PassAppEC2Role",
			"Effect": "Allow",
			"Action": "iam:PassRole",
			"Resource": "arn:aws:iam::257074875139:role/APP-EC2-ROLE",
			"Condition": {
				"StringEquals": {
					"iam:PassedToService": "ec2.amazonaws.com"
				}
			}
		},
		{
			"Sid": "ManageAppEC2InstanceProfile",
			"Effect": "Allow",
			"Action": [
				"iam:GetInstanceProfile",
				"iam:CreateInstanceProfile",
				"iam:DeleteInstanceProfile",
				"iam:AddRoleToInstanceProfile",
				"iam:RemoveRoleFromInstanceProfile",
				"iam:TagInstanceProfile",
				"iam:UntagInstanceProfile"
			],
			"Resource": "arn:aws:iam::257074875139:instance-profile/APP-EC2-PROFILE"
		},
		{
			"Sid": "FinanceRoute53",
			"Effect": "Allow",
			"Action": [
				"route53:ChangeResourceRecordSets",
				"route53:GetHostedZone",
				"route53:ListResourceRecordSets",
				"route53:GetChange"
			],
			"Resource": "*"
		},
		{
			"Sid": "ReadInfrastructure",
			"Effect": "Allow",
			"Action": [
				"ec2:Describe*",
				"elasticloadbalancing:Describe*",
				"autoscaling:Describe*",
				"cloudwatch:Describe*",
				"cloudwatch:Get*",
				"cloudwatch:List*",
				"sns:Get*",
				"sns:List*",
				"iam:Get*",
				"iam:List*",
				"route53:Get*",
				"route53:List*"
			],
			"Resource": "*"
		}
	]
}
