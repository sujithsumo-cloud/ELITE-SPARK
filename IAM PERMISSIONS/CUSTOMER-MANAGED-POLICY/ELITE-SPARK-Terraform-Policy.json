{
	"Version": "2012-10-17",
	"Statement": [
		{
			"Sid": "MumbaiECRAuthorization",
			"Effect": "Allow",
			"Action": "ecr:GetAuthorizationToken",
			"Resource": "*"
		},
		{
			"Sid": "ManageMumbaiECR",
			"Effect": "Allow",
			"Action": [
				"ecr:CreateRepository",
				"ecr:DeleteRepository",
				"ecr:PutImageScanningConfiguration",
				"ecr:PutImageTagMutability",
				"ecr:BatchCheckLayerAvailability",
				"ecr:InitiateLayerUpload",
				"ecr:UploadLayerPart",
				"ecr:CompleteLayerUpload",
				"ecr:PutImage"
			],
			"Resource": "arn:aws:ecr:ap-south-1:257074875139:repository/finance-app"
		},
		{
			"Sid": "DynamoDBRestoreDemoAccess",
			"Effect": "Allow",
			"Action": [
				"dynamodb:GetItem",
				"dynamodb:Scan",
				"dynamodb:Query",
				"dynamodb:DescribeTable"
			],
			"Resource": "arn:aws:dynamodb:ap-south-2:257074875139:table/FIN-TRANSACTIONS-RESTORE-DEMO"
		},
		{
			"Sid": "ManageFinanceGlobalTable",
			"Effect": "Allow",
			"Action": [
				"dynamodb:CreateTable",
				"dynamodb:CreateTableReplica",
				"dynamodb:DeleteTable",
				"dynamodb:DeleteTableReplica",
				"dynamodb:UpdateTable",
				"dynamodb:UpdateContinuousBackups",
				"dynamodb:TagResource",
				"dynamodb:UntagResource",
				"dynamodb:GetItem",
				"dynamodb:PutItem",
				"dynamodb:UpdateItem",
				"dynamodb:DeleteItem",
				"dynamodb:BatchWriteItem",
				"dynamodb:Query",
				"dynamodb:Scan"
			],
			"Resource": [
				"arn:aws:dynamodb:ap-south-2:257074875139:table/FIN-TRANSACTIONS",
				"arn:aws:dynamodb:ap-south-1:257074875139:table/FIN-TRANSACTIONS"
			]
		},
		{
			"Sid": "DynamoDBServiceRole",
			"Effect": "Allow",
			"Action": "iam:CreateServiceLinkedRole",
			"Resource": "*",
			"Condition": {
				"StringEquals": {
					"iam:AWSServiceName": "replication.dynamodb.amazonaws.com"
				}
			}
		},
		{
			"Sid": "ReadMumbaiAMIParameter",
			"Effect": "Allow",
			"Action": [
				"ssm:GetParameter",
				"ssm:GetParameters"
			],
			"Resource": "arn:aws:ssm:ap-south-1::parameter/aws/service/ecs/optimized-ami/amazon-linux-2023/*"
		},
		{
			"Sid": "ManageMumbaiDRS3",
			"Effect": "Allow",
			"Action": [
				"s3:CreateBucket",
				"s3:DeleteBucket",
				"s3:PutBucketVersioning",
				"s3:PutBucketTagging",
				"s3:PutEncryptionConfiguration",
				"s3:PutBucketPublicAccessBlock",
				"s3:PutLifecycleConfiguration",
				"s3:PutObject",
				"s3:PutObjectTagging",
				"s3:DeleteObject",
				"s3:DeleteObjectVersion"
			],
			"Resource": [
				"arn:aws:s3:::elite-spark-finance-mum-*",
				"arn:aws:s3:::elite-spark-finance-mum-*/*"
			]
		},
		{
			"Sid": "ManageS3CRRRole",
			"Effect": "Allow",
			"Action": [
				"iam:CreateRole",
				"iam:DeleteRole",
				"iam:UpdateAssumeRolePolicy",
				"iam:PutRolePolicy",
				"iam:DeleteRolePolicy",
				"iam:TagRole",
				"iam:UntagRole"
			],
			"Resource": "arn:aws:iam::257074875139:role/ELITE-SPARK-S3-CRR-ROLE"
		},
		{
			"Sid": "PassS3CRRRole",
			"Effect": "Allow",
			"Action": "iam:PassRole",
			"Resource": "arn:aws:iam::257074875139:role/ELITE-SPARK-S3-CRR-ROLE",
			"Condition": {
				"StringEquals": {
					"iam:PassedToService": "s3.amazonaws.com"
				}
			}
		},
		{
			"Sid": "ManageHyderabadS3",
			"Effect": "Allow",
			"Action": [
				"s3:PutReplicationConfiguration",
				"s3:PutBucketPolicy",
				"s3:PutObject",
				"s3:DeleteObject",
				"s3:DeleteObjectVersion"
			],
			"Resource": [
				"arn:aws:s3:::elite-spark-finance-hyd-78b15ff1399189995156c8a3a2",
				"arn:aws:s3:::elite-spark-finance-hyd-78b15ff1399189995156c8a3a2/*"
			]
		},
		{
			"Sid": "ManageFinanceDNS",
			"Effect": "Allow",
			"Action": "route53:ChangeResourceRecordSets",
			"Resource": "arn:aws:route53:::hostedzone/*",
			"Condition": {
				"ForAllValues:StringEquals": {
					"route53:ChangeResourceRecordSetsRecordTypes": [
						"A"
					]
				},
				"ForAllValues:StringLike": {
					"route53:ChangeResourceRecordSetsNormalizedRecordNames": [
						"finance.best.2bd.net"
					]
				}
			}
		},
		{
			"Sid": "ManageGitHubOIDC",
			"Effect": "Allow",
			"Action": "iam:CreateOpenIDConnectProvider",
			"Resource": "*"
		},
		{
			"Sid": "ManageGitHubActionsRole",
			"Effect": "Allow",
			"Action": [
				"iam:CreateRole",
				"iam:UpdateAssumeRolePolicy",
				"iam:PutRolePolicy",
				"iam:DeleteRolePolicy",
				"iam:TagRole"
			],
			"Resource": "arn:aws:iam::257074875139:role/ELITE-SPARK-GITHUB-ACTIONS-ROLE"
		},
		{
			"Sid": "ManageEliteSparkAutoScaling",
			"Effect": "Allow",
			"Action": [
				"autoscaling:StartInstanceRefresh",
				"autoscaling:UpdateAutoScalingGroup"
			],
			"Resource": [
				"arn:aws:autoscaling:ap-south-2:257074875139:autoScalingGroup:*:autoScalingGroupName/HYD-APP-ASG",
				"arn:aws:autoscaling:ap-south-1:257074875139:autoScalingGroup:*:autoScalingGroupName/MUM-APP-ASG"
			]
		},
		{
			"Sid": "ManageEliteSparkCloudWatchAlarms",
			"Effect": "Allow",
			"Action": "cloudwatch:PutMetricAlarm",
			"Resource": "arn:aws:cloudwatch:ap-south-2:257074875139:alarm:HYD-*"
		},
		{
			"Sid": "ReadProjectConsole",
			"Effect": "Allow",
			"Action": [
				"ec2:Describe*",
				"elasticloadbalancing:Describe*",
				"autoscaling:Describe*",
				"cloudwatch:Describe*",
				"cloudwatch:Get*",
				"cloudwatch:List*",
				"sns:Get*",
				"sns:List*",
				"s3:Get*",
				"s3:List*",
				"dynamodb:Describe*",
				"dynamodb:List*",
				"ecr:Describe*",
				"ecr:Get*",
				"ecr:List*",
				"ecr:BatchGetImage",
				"iam:Get*",
				"iam:List*",
				"route53:Get*",
				"route53:List*",
				"kms:DescribeKey",
				"kms:ListAliases",
				"kms:ListKeys",
				"tag:Get*"
			],
			"Resource": "*"
		}
	]
}
